{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=studio_book_db;User=studio;Password=studio_pass;"
  },
  "Jwt": {
    "Issuer": "StudioBookApi",
    "Audience": "StudioBookClient",
    "SigningKey": "DUMMY_DEVELOPMENT_SIGNING_KEY_REPLACE_WITH_USER_SECRETS",
    "AccessTokenMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Batch": {
    "Enabled": true,
    "RunAtJapanTime": "04:00",
    "CheckIntervalMinutes": 15,
    "InitialDelaySeconds": 60,
    "AiSearchLogRetentionDays": 90,
    "AuditLogRetentionDays": 365,
    "TokenRetentionDays": 7,
    "DeleteChunkSize": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
