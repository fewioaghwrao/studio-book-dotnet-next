<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Application 層: ユースケース（業務ロジック）・DTO・外部依存の抽象（インターフェース）を持ちます。
    依存先は Domain 層のみ。DB や外部 API の具体的な実装は Infrastructure 層に置きます。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- LINQ to Entities（Include / ToListAsync など）と DbSet を IAppDbContext 経由で使うため -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.1" />
    <!-- PasswordResetService が IPasswordHasher<User> を利用するため -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Studiobook_backend.Domain\Studiobook_backend.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 旧 Web プロジェクト（Microsoft.NET.Sdk.Web）の暗黙 using のうち、移設したコードが使っているもの -->
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
