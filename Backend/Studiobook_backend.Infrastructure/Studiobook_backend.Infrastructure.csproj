<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure 層: Application 層のインターフェースの実装を持ちます。
    EF Core(MySQL) の DbContext・マイグレーション・シーダー、メール送信、JWT 発行、
    パスワードハッシュ、OpenAI / Stripe などの外部サービス連携、CSV / PDF の帳票出力。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- IConfiguration / ILogger / HttpClientFactory / ASP.NET Core Identity の PasswordHasher など -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.22" />
    <!--
      Pomelo は EF Core 10 対応版が未リリースのため、EF Core は 9.0.x（最新パッチ）を使用する。
      Pomelo 9.0.0 が依存する MySqlConnector 2.4.0 には脆弱性（GHSA-473q-m89c-ghf8）があるため、修正版を直接指定する。
    -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
    <PackageReference Include="Stripe.net" Version="51.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Studiobook_backend.Application\Studiobook_backend.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 旧 Web プロジェクト（Microsoft.NET.Sdk.Web）と同じ暗黙 using -->
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
